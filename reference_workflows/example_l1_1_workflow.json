[
  {
    "step_id": 1,
    "operation": "计算降雨侵蚀力因子 (R)",
    "description": "基于年降雨量数据，采用RUSLE模型中的降雨侵蚀力公式计算R因子。使用年降雨量（mm）直接作为R因子的代理变量，单位为MJ·mm/(hm²·h·年)。根据经验公式：R = 0.013 × P^1.3，其中P为年降雨量（mm）。",
    "factor_name": "R",
    "input_files": [
      "rainfall_year"
    ],
    "output_file": "R_factor_2022.tif",
    "dependencies": [],
    "tool_library": "gdal",
    "algorithm_formula": "RUSLE_R_factor",
    "parameters": {
      "constants": {
        "a": 0.013,
        "b": 1.3
      },
      "thresholds": {},
      "lookup_table": {},
      "units": "MJ·mm/(hm²·h·年)",
      "notes": "R因子基于年降雨量经验公式估算，未考虑降雨强度分布。"
    }
  },
  {
    "step_id": 2,
    "operation": "计算土壤可蚀性因子 (K)",
    "description": "基于土壤质地数据，采用USLE/K因子经验公式计算K因子。K = 0.2 × (100 - clay) × (1 - silt/100) × (1 - sand/100) × (1 - toc/100)，其中clay、silt、sand、toc为各土壤组分百分比（%）。使用clay、silt、sand、toc数据进行计算。",
    "factor_name": "K",
    "input_files": [
      "soil_clay",
      "soil_silt",
      "soil_sand",
      "soil_toc"
    ],
    "output_file": "K_factor_2022.tif",
    "dependencies": [],
    "tool_library": "gdal",
    "algorithm_formula": "USLE_K_factor",
    "parameters": {
      "constants": {
        "scaling": 0.2
      },
      "thresholds": {
        "min_clay": 0,
        "max_clay": 100,
        "min_silt": 0,
        "max_silt": 100,
        "min_sand": 0,
        "max_sand": 100,
        "min_toc": 0,
        "max_toc": 100
      },
      "lookup_table": {},
      "units": "t·h/(MJ·mm)",
      "notes": "K因子基于土壤质地四分量计算，单位为t·h/(MJ·mm)，需确保输入数据为百分比（0-100）。"
    }
  },
  {
    "step_id": 3,
    "operation": "计算地形因子 (LS)",
    "description": "基于填洼后的DEM计算坡度和坡长因子。首先计算坡度（degrees），然后根据坡度分段计算坡长因子L。采用RUSLE标准分段：坡度<8%时，L = (λ/22.13)^m；坡度≥8%时，L = (λ/22.13)^m × (1 + 0.5 × (1 - 0.08/θ))，其中λ为坡长（m），θ为坡度（degrees），m=1.3。最终LS = L × S。S为坡度因子，S = sin(θ) / 0.0896。使用填洼DEM计算坡度和坡长。",
    "factor_name": "LS",
    "input_files": [
      "dem_filled"
    ],
    "output_file": "LS_factor_2022.tif",
    "dependencies": [],
    "tool_library": "gdal",
    "algorithm_formula": "RUSLE_LS_factor",
    "parameters": {
      "constants": {
        "m": 1.3,
        "lambda_ref": 22.13,
        "s_ref": 0.0896
      },
      "thresholds": {
        "slope_threshold": 8.0
      },
      "lookup_table": {},
      "units": "无量纲",
      "notes": "LS因子基于填洼DEM计算，坡度单位为度，坡长单位为米。"
    }
  },
  {
